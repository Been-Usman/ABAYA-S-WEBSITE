    .theme-toggle { width: 36px; height: 36px; font-size: 1rem; }
    .cart-icon-container i { font-size: 1.25rem; }
    .hamburger { display: none !important; }
    .mobile-menu { display: none !important; }
}

/* ============================================================
   MOBILE (< 768px)
   Logo+Name | Theme | Cart | Hamburger
   ============================================================ */
@media (max-width: 767px) {
    nav { padding: 0 14px; height: 66px; gap: 8px; }

    .nav-logo .logo-img { width: 42px; height: 42px; }
    .nav-logo .brand-title { font-size: 0.85rem; letter-spacing: 0.5px; }

    /* HIDDEN */
    .nav-links { display: none !important; }
    .nav-search { display: none !important; }

    /* VISIBLE */
    .theme-toggle {
        display: flex !important;
        width: 36px;
        height: 36px;
        font-size: 1rem;
    }
    .cart-icon-container { display: flex !important; }
    .cart-icon-container i { font-size: 1.2rem; }
    .hamburger {
        display: flex !important;
        align-items: center;
        justify-content: center;
        padding: 6px;
    }
    .hamburger span { width: 22px; }

    .nav-actions { gap: 6px; }
    .mobile-menu { display: block !important; }
}

/* ============================================================
   SMALL PHONE (< 500px)
   ============================================================ */
@media (max-width: 500px) {
    nav { padding: 0 10px; height: 62px; }
    .nav-logo .logo-img { width: 38px; height: 38px; }
    .nav-logo .brand-title { font-size: 0.75rem; }
    .theme-toggle { width: 32px; height: 32px; font-size: 0.9rem; }
    .cart-icon-container i { font-size: 1.15rem; }
    .hamburger span { width: 20px; }
    .nav-actions { gap: 4px; }
}

/* ============================================================
   VERY SMALL PHONE (< 380px)
   ============================================================ */
@media (max-width: 380px) {
    nav { padding: 0 8px; height: 58px; }
    .nav-logo .logo-img { width: 34px; height: 34px; border-width: 2px; }
    .nav-logo .brand-title { font-size: 0.68rem; letter-spacing: 0; }
    .theme-toggle { width: 30px; height: 30px; font-size: 0.85rem; }
    .cart-icon-container i { font-size: 1.05rem; }
    .hamburger span { width: 18px; }
    .nav-actions { gap: 3px; }
}