/* ============================================================
   NAKOWA ABAYAS COLLECTIONS — Admin Script v7
   Full rewrite — IndexedDB queue integrated.

   Load order in admin/admin.html:
     ../config.js   ../queue.js   admin.js

   HONEST LIMITS
     • The admin's OWN browser sees new products instantly.
       Customers on other devices see them after the backend save.
     • Browsers cannot upload after the tab is fully closed.
       Jobs persist in IndexedDB and resume on the next visit.
     • IndexedDB unavailable → direct-upload fallback with a toast.
   ============================================================ */

'use strict';

// ============================================================
// STATE
// ============================================================
let authToken = '';
let currentAdmin = '';
let currentSection = 'dashboard';

let cachedProducts = null;
let cachedOrders = null;
let cachedSettings = null;
let cachedCustomers = null;
let cachedUsers = null;

let selectedProductIds = new Set();
let productSearchQuery = '';

let uploadFiles = [];
let currentVariantIndex = 0;
let currentBatch = [];

let supabaseBucket = (typeof SUPABASE !== 'undefined' && SUPABASE.bucket) || 'Product-images';
let salesChartInstance = null;

let _idleTimer = null;
let _queueUnsubscribers = [];
let _softLogoutPending = false;
let _bannerEl = null;

// ============================================================
// VIEW TOKEN
// ============================================================
let viewToken = 0;
function bumpViewToken() { viewToken++; return viewToken; }
function isViewCurrent(token) { return token === viewToken; }

// ============================================================
// UTILITIES
// ============================================================
function $(id) { return document.getElementById(id); }

const DEFAULT_IMG_LOCAL = (typeof DEFAULT_IMG !== 'undefined') ? DEFAULT_IMG : (window.FALLBACK_IMG || '');

if (typeof window.imgFallback !== 'function') {
    window.imgFallback = function (img) {
        if (!img || img.dataset.fbApplied === '1') return;
        img.dataset.fbApplied = '1';
        img.onerror = null;
        img.src = DEFAULT_IMG_LOCAL;
    };
}

const _reportedOnce = new Set();
function logOnce(key, message, detail) {
    if (_reportedOnce.has(key)) return;
    _reportedOnce.add(key);
    if (detail === undefined) console.error(message);
    else console.error(message, detail);
}
function warnOnce(key, message, detail) {
    if (_reportedOnce.has(key)) return;
    _reportedOnce.add(key);
    if (detail === undefined) console.warn(message);
    else console.warn(message, detail);
}

function showToast(msg, icon) {
    icon = icon || '✅';
    const t = $('toast');
    if (!t) return;
    const msgEl = $('toastMessage');
    if (msgEl) msgEl.textContent = msg;
    const iconEl = t.querySelector('.toast-icon');
    if (iconEl) iconEl.textContent = icon;
    t.classList.add('show');
    clearTimeout(t._timer);
    t._timer = setTimeout(function () { t.classList.remove('show'); }, 4000);
}

function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str).replace(/[&<>"']/g, function (s) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[s];
    });
}

function formatMoney(n) { return '₦' + (parseFloat(n) || 0).toLocaleString(); }

function generateId(prefix) {
    prefix = prefix || 'P';
    const ts = Date.now().toString(36).toUpperCase();
    const rand = Math.random().toString(36).substring(2, 6).toUpperCase();
    return prefix + '-' + ts + '-' + rand;
}

function normalizeProductCode(code) {
    code = (code || '').trim();
    if (!code) return 'NAK-000';
    if (/^\d+$/.test(code)) return 'NAK-' + code;
    if (code.indexOf('NAK-') === 0) return code;
    return code;
}

function renderPrice(actualPrice) {
    const actual = parseFloat(actualPrice) || 0;
    const fake = actual + 5000;
    return '<span class="price-actual">₦' + actual.toLocaleString() + '</span>' +
           '<span class="price-fake">₦' + fake.toLocaleString() + '</span>';
}

function formatOrderIdDisplay(orderId, adminCode) {
    if (!orderId) return { code: '', date: '', serial: null };
    if (adminCode && orderId.indexOf(adminCode + '-') === 0) {
        const rest = orderId.substring(adminCode.length + 1);
        const parts = rest.split('-');
        if (parts.length >= 3) {
            return { code: adminCode, date: parts.slice(0, 3).join('-'), serial: parts.slice(3).join('-') || null };
        }
    }
    const parts = orderId.split('-');
    if (parts.length >= 4) {
        return { code: parts.slice(0, -3).join('-'), date: parts.slice(-3).join('-'), serial: null };
    }
    return { code: orderId, date: '', serial: null };
}

function applyVideo10sLoop(container) {
    if (!container) return;
    container.querySelectorAll('video').forEach(function (v) {
        if (v._loop10sAttached) return;
        v._loop10sAttached = true;
        v.muted = true;
        v.setAttribute('muted', '');
        v.setAttribute('playsinline', '');
        v.autoplay = true;
        v.loop = false;
        v.addEventListener('timeupdate', function () {
            if (this.currentTime >= 10) { this.currentTime = 0; this.play().catch(function () {}); }
        });
        v.addEventListener('loadeddata', function () { v.play().catch(function () {}); });
        v.play().catch(function () {});
    });
}

// ============================================================
// API
// ============================================================
async function apiGet(action) {
    const token = (typeof getToken === 'function') ? getToken() : '';
    const url = token
        ? API_URL + '?action=' + encodeURIComponent(action) + '&token=' + encodeURIComponent(token)
        : API_URL + '?action=' + encodeURIComponent(action);
    const res = await fetch(url);
    return res.json();
}

async function apiPost(action, data) {
    data = data || {};
    const payload = Object.assign({ action: action }, data);
    if (!payload.token && typeof getToken === 'function') {
        const t = getToken();
        if (t) payload.token = t;
    }
    const res = await fetch(API_URL, { method: 'POST', body: JSON.stringify(payload) });
    return res.json();
}

// ============================================================
// TOKEN
// ============================================================
function saveToken(token, username) {
    try {
        sessionStorage.setItem(TOKEN_KEY, 'local-session');
        sessionStorage.setItem(TOKEN_TIME_KEY, Date.now().toString());
        sessionStorage.setItem(USER_KEY, username || '');
    } catch (e) {}
}
function getToken() {
    let token = '', time = 0;
    try {
        token = sessionStorage.getItem(TOKEN_KEY) || '';
        time = parseInt(sessionStorage.getItem(TOKEN_TIME_KEY) || '0', 10);
    } catch (e) { return ''; }
    if (!token) return '';
    if (Date.now() - time > TOKEN_LIFETIME_MS) { clearToken(); return ''; }
    return token;
}
function clearToken() {
    try {
        sessionStorage.removeItem(TOKEN_KEY);
        sessionStorage.removeItem(TOKEN_TIME_KEY);
        sessionStorage.removeItem(USER_KEY);
    } catch (e) {}
    try { localStorage.removeItem('nakowa_admin_owner'); } catch (e) {}
}

// ============================================================
// SESSION
// ============================================================
function getAdminCredentials() {
    try {
        const raw = localStorage.getItem(AUTH_CONFIG_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return null;
        return parsed;
    } catch (e) { return null; }
}
function saveAdminCredentials(cfg) {
    try { localStorage.setItem(AUTH_CONFIG_KEY, JSON.stringify(cfg || {})); } catch (e) {}
}
function clearAdminSession() {
    clearToken();
    authToken = '';
    currentAdmin = '';
    stopIdleTimer();
}
function createAdminSession(token, username) {
    saveToken(token, username);
    authToken = token;
    currentAdmin = username || '';
    startIdleTimer();
}
function isAdminAuthenticated() { return !!getToken(); }

function startIdleTimer() {
    stopIdleTimer();
    if (_softLogoutPending) return;
    _idleTimer = setInterval(checkSessionTimeout, 60 * 1000);
    ['click', 'keypress', 'scroll', 'touchstart'].forEach(function (evt) {
        document.addEventListener(evt, bumpIdle, { passive: true });
    });
}
function stopIdleTimer() {
    if (_idleTimer) { clearInterval(_idleTimer); _idleTimer = null; }
    ['click', 'keypress', 'scroll', 'touchstart'].forEach(function (evt) {
        document.removeEventListener(evt, bumpIdle);
    });
}
function bumpIdle() {
    try { if (getToken()) sessionStorage.setItem(TOKEN_TIME_KEY, Date.now().toString()); } catch (e) {}
}
function checkSessionTimeout() {
    if (_softLogoutPending) return;
    if (!getToken()) return;
    let time = 0;
    try { time = parseInt(sessionStorage.getItem(TOKEN_TIME_KEY) || '0', 10); } catch (e) {}
    if (time && Date.now() - time > SESSION_IDLE_MS) {
        showToast('Session expired. Please log in again.', '🔒');
        doLogout(true);
    }
}
function handleFailedLogin() {
    let cfg = getAdminCredentials() || {};
    const now = Date.now();
    cfg.failedAttempts = (cfg.failedAttempts || 0) + 1;
    cfg.lockedUntil = 0;
    if (cfg.failedAttempts >= 5) {
        cfg.lockedUntil = now + 5 * 60 * 1000;
        cfg.failedAttempts = 0;
    }
    saveAdminCredentials(cfg);
}
function isLoginLocked() {
    const cfg = getAdminCredentials();
    if (!cfg || !cfg.lockedUntil) return 0;
    const remaining = cfg.lockedUntil - Date.now();
    if (remaining <= 0) {
        const clean = Object.assign({}, cfg);
        delete clean.lockedUntil;
        clean.failedAttempts = 0;
        saveAdminCredentials(clean);
        return 0;
    }
    return remaining;
}
function clearFailedAttempts() {
    const cfg = getAdminCredentials() || {};
    delete cfg.failedAttempts;
    delete cfg.lockedUntil;
    saveAdminCredentials(cfg);
}

// ============================================================
// LOGIN / LOGOUT
// ============================================================

// ============================================================
// LOCAL CREDENTIALS (client-side authentication)
// ------------------------------------------------------------
// Password is NEVER stored. Only a salted SHA-256 hash lives in
// localStorage. Default on first run: umar / 0708070.
// ============================================================
const LOCAL_PW_SALT = 'NAKOWA_LOCAL_SALT_v1';

async function sha256Hex(text) {
    const buf = new TextEncoder().encode(text);
    const hash = await crypto.subtle.digest('SHA-256', buf);
    return Array.from(new Uint8Array(hash)).map(function (b) {
        return b.toString(16).padStart(2, '0');
    }).join('');
}

async function hashLocalPassword(username, password) {
    return sha256Hex(LOCAL_PW_SALT + '|' + username + '|' + password);
}

async function ensureLocalCredSeed() {
    const cfg = getAdminCredentials();
    if (cfg && cfg.username && cfg.passwordHash) return cfg;
    const username = 'umar';
    const password = '0708070';
    const passwordHash = await hashLocalPassword(username, password);
    const newCfg = { username: username, passwordHash: passwordHash, updatedAt: Date.now() };
    saveAdminCredentials(newCfg);
    return newCfg;
}

async function verifyLocalCredentials(username, password) {
    const cfg = await ensureLocalCredSeed();
    if (!cfg || !cfg.username) return false;
    if (String(username) !== String(cfg.username)) return false;
    const hash = await hashLocalPassword(username, password);
    return hash === cfg.passwordHash;
}

async function setLocalCredentials(username, password) {
    const passwordHash = await hashLocalPassword(username, password);
    saveAdminCredentials({
        username: username,
        passwordHash: passwordHash,
        updatedAt: Date.now()
    });
}

async function doLogin() {
    const username = $('loginUsername').value.trim();
    const password = $('loginPassword').value;
    const errEl = $('loginError');
    const btn = $('loginBtn');

    function showError(msg) { errEl.textContent = msg; errEl.style.display = 'block'; }

    const lockRemaining = isLoginLocked();
    if (lockRemaining > 0) {
        const mins = Math.ceil(lockRemaining / 60000);
        showError('Too many failed attempts. Please try again in ' + mins + ' minute(s).');
        return;
    }
    if (!username || !password) { showError('Invalid username or password.'); return; }

    errEl.style.display = 'none';
    btn.disabled = true;
    btn.textContent = 'Logging in...';

    try {
        const ok = await verifyLocalCredentials(username, password);
        if (!ok) {
            handleFailedLogin();
            showError('Invalid username or password.');
            return;
        }
        clearFailedAttempts();
        createAdminSession('local-session', username);
        await warmCache();
        $('loginScreen').style.display = 'none';
        $('dashboard').style.display = 'flex';
        initQueueAfterLogin();
        const token = bumpViewToken();
        loadSection('dashboard', token);
    } catch (err) {
        showError('Network error. Please try again.');
        logOnce('login-net-' + err.message, '[Login] Network error:', err);
    } finally {
        btn.disabled = false;
        btn.textContent = 'Login';
    }
}

async function doLogout(immediate) {
    if (!immediate && typeof NakowaQueue !== 'undefined' && NakowaQueue.isAvailable()) {
        let stats = null;
        try { stats = await NakowaQueue.getQueueStats(); } catch (e) {}
        if (stats && stats.activeJobs > 0) {
            showToast('Uploads are still running. The page will stay open until they finish.', '⏳');
            enterSoftLogout();
            return;
        }
    }
    clearAdminSession();
    cachedProducts = null; cachedOrders = null; cachedSettings = null;
    cachedCustomers = null; cachedUsers = null;
    try { await apiPost('logout', {}); } catch (e) {}
    window.location.href = '../index.html';
}

function enterSoftLogout() {
    _softLogoutPending = true;
    stopIdleTimer();
    $('dashboard').style.display = 'none';
    $('loginScreen').style.display = 'flex';
    renderQueueBanner();
}
async function finishSoftLogout() {
    _softLogoutPending = false;
    clearAdminSession();
    try { await apiPost('logout', {}); } catch (e) {}
    window.location.href = '../index.html';
}
function checkAuth() { return getToken(); }

// ============================================================
// WARM CACHE
// ============================================================
async function warmCache() {
    try {
        const results = await Promise.all([
            apiGet('products').catch(function () { return []; }),
            apiGet('orders').catch(function () { return []; }),
            apiGet('settings').catch(function () { return {}; })
        ]);
        cachedProducts = results[0] || [];
        cachedOrders = results[1] || [];
        cachedSettings = results[2] || {};
    } catch (e) {
        cachedProducts = cachedProducts || [];
        cachedOrders = cachedOrders || [];
        cachedSettings = cachedSettings || {};
        warnOnce('warm-cache-failed', '[API] Initial prefetch failed.', e);
    }
}

// ============================================================
// QUEUE INTEGRATION
// ============================================================
function initQueueAfterLogin() {
    try { NakowaQueue.removeLegacyLocalStorageKey(); } catch (e) {}
    if (!NakowaQueue.isAvailable()) {
        warnOnce('queue-unavailable', '[Queue] IndexedDB unavailable — direct upload fallback.');
        return;
    }
    _queueUnsubscribers.forEach(function (fn) { try { fn(); } catch (e) {} });
    _queueUnsubscribers = [];
    _queueUnsubscribers.push(NakowaQueue.onEvent(function (ev) {
        renderQueueBanner();
        if (ev.type === 'job-done' || ev.type === 'job-error' || ev.type === 'job-progress') {
            if (currentSection === 'products') drawProductsSection();
        }
        if (ev.type === 'worker-idle') {
            NakowaQueue.getQueueStats().then(function (s) {
                if (s.activeJobs === 0 && _softLogoutPending) finishSoftLogout();
            }).catch(function () {});
        }
    }));
    NakowaQueue.startWorker({ getToken: function () { return getToken(); } }).catch(function (err) {
        warnOnce('queue-start-failed', '[Queue] Worker failed to start:', err);
    });
    renderQueueBanner();
    installBeforeUnloadGuard();
}

function installBeforeUnloadGuard() {
    if (window._nakowaBeforeUnloadInstalled) return;
    window._nakowaBeforeUnloadInstalled = true;
    window.addEventListener('beforeunload', function (e) {
        if (typeof NakowaQueue === 'undefined') return;
        if (_softLogoutPending) { e.preventDefault(); e.returnValue = ''; return; }
        if (_bannerEl && _bannerEl.dataset.active === '1') { e.preventDefault(); e.returnValue = ''; }
    });
}

function renderQueueBanner() {
    if (typeof NakowaQueue === 'undefined' || !NakowaQueue.isAvailable()) return;
    NakowaQueue.getQueueStats().then(function (stats) {
        const active = stats.activeJobs > 0;
        if (!active) { if (_bannerEl) { _bannerEl.remove(); _bannerEl = null; } return; }
        if (!_bannerEl) {
            _bannerEl = document.createElement('div');
            _bannerEl.id = 'nakowaQueueBanner';
            _bannerEl.style.cssText = 'position:fixed;left:50%;bottom:20px;transform:translateX(-50%);' +
                'background:#111;color:#f9e508;border:1px solid #f9e508;border-radius:30px;' +
                'padding:10px 18px;font-size:0.85rem;z-index:9999;box-shadow:0 6px 30px rgba(0,0,0,0.6);';
            document.body.appendChild(_bannerEl);
        }
        _bannerEl.dataset.active = '1';
        _bannerEl.textContent = 'Uploading ' + stats.uploaded + '/' + stats.total +
            ' in background (' + stats.activeJobs + ' job' + (stats.activeJobs === 1 ? '' : 's') + ')';
    }).catch(function () {});
}

// ============================================================
// NAVIGATION
// ============================================================
function loadSection(section, preassignedToken) {
    currentSection = section;
    const myToken = (typeof preassignedToken === 'number') ? preassignedToken : bumpViewToken();

    if (section !== 'dashboard' && salesChartInstance) {
        try { salesChartInstance.destroy(); } catch (e) {}
        salesChartInstance = null;
    }
    document.querySelectorAll('.sidebar li[data-section]').forEach(function (el) {
        el.classList.toggle('active', el.dataset.section === section);
    });
    const sidebar = $('sidebar');
    if (sidebar) sidebar.classList.remove('open');
    if (section !== 'products') selectedProductIds.clear();

    switch (section) {
        case 'dashboard':      renderDashboard(myToken); break;
        case 'products':       renderProducts(myToken); break;
        case 'orders':         renderOrders(myToken); break;
        case 'customers':      renderCustomers(myToken); break;
        case 'settings':       renderSettings(myToken); break;
        case 'users':          renderUsers(myToken); break;
        case 'changepassword': renderChangePassword(myToken); break;
    }
}

// ============================================================
// DASHBOARD
// ============================================================
async function renderDashboard(myToken) {
    if (typeof myToken !== 'number') myToken = viewToken;
    $('pageTitle').textContent = 'Dashboard';
    $('topbarDate').textContent = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    currentSection = 'dashboard';
    if (cachedProducts === null) cachedProducts = [];
    if (cachedOrders === null) cachedOrders = [];
    if (cachedSettings === null) cachedSettings = {};
    drawDashboard();
    try {
        const results = await Promise.all([apiGet('products'), apiGet('orders'), apiGet('settings')]);
        if (!isViewCurrent(myToken)) return;
        cachedProducts = results[0] || [];
        cachedOrders = results[1] || [];
        cachedSettings = results[2] || {};
        if (currentSection === 'dashboard') drawDashboard();
    } catch (e) { logOnce('dash-refresh-failed', '[Dashboard] refresh failed:', e); }
}

function drawDashboard() {
    const area = $('contentArea');
    const lowThreshold = parseInt(cachedSettings.lowStockThreshold || 3, 10);
    const totalProducts = cachedProducts.length;
    const totalOrders = cachedOrders.length;
    const totalRevenue = cachedOrders.filter(function (o) { return o.status !== 'cancelled'; })
        .reduce(function (s, o) { return s + (parseFloat(o.total) || 0); }, 0);
    const pendingOrders = cachedOrders.filter(function (o) { return o.status === 'pending'; }).length;
    const lowStock = cachedProducts.filter(function (p) {
        const st = parseInt(p.stock || 0, 10);
        return st <= lowThreshold && st > 0;
    });
    const outOfStock = cachedProducts.filter(function (p) { return parseInt(p.stock || 0, 10) === 0; });

    const last7 = [];
    for (let i = 6; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        const dStr = d.getDate() + '-' + (d.getMonth() + 1) + '-' + d.getFullYear();
        const dayOrders = cachedOrders.filter(function (o) { return (o.date || '') === dStr; });
        last7.push({
            label: d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }),
            count: dayOrders.length,
            revenue: dayOrders.reduce(function (s, o) { return s + (parseFloat(o.total) || 0); }, 0)
        });
    }

    let lowStockHTML = '';
    if (lowStock.length > 0 || outOfStock.length > 0) {
        lowStockHTML = '<div class="admin-card"><div class="card-title"><span><i class="fas fa-exclamation-triangle" style="color:#f59e0b;"></i> Stock Alerts</span></div>' +
            '<ul class="recent-list">' +
                outOfStock.map(function (p) {
                    return '<li><span class="product-name">' + escapeHtml(p.name) + ' (' + escapeHtml(p.code) + ')</span><span style="color:#e74c3c;font-weight:700;">OUT OF STOCK</span></li>';
                }).join('') +
                lowStock.map(function (p) {
                    return '<li><span class="product-name">' + escapeHtml(p.name) + ' (' + escapeHtml(p.code) + ')</span><span style="color:#f59e0b;font-weight:700;">' + p.stock + ' left</span></li>';
                }).join('') +
            '</ul></div>';
    }

    const recentProducts = cachedProducts.slice(-5).reverse().map(function (p) {
        return '<li><span class="product-name">' + escapeHtml(p.name) + '</span><span class="product-country">' + escapeHtml(p.country || 'Egypt') + '</span></li>';
    }).join('') || '<li style="opacity:0.5;">No products yet</li>';

    area.innerHTML =
        '<div class="admin-stats-grid">' +
            '<div class="admin-stat-card"><span class="stat-icon"><i class="fas fa-box"></i></span>' +
                '<div class="stat-number">' + totalProducts + '</div><div class="stat-label">Products</div></div>' +
            '<div class="admin-stat-card"><span class="stat-icon"><i class="fas fa-shopping-bag"></i></span>' +
                '<div class="stat-number">' + totalOrders + '</div><div class="stat-label">Orders</div></div>' +
            '<div class="admin-stat-card"><span class="stat-icon"><i class="fas fa-money-bill-wave"></i></span>' +
                '<div class="stat-number" style="font-size:1.4rem;">' + formatMoney(totalRevenue) + '</div>' +
                '<div class="stat-label">Revenue</div></div>' +
            '<div class="admin-stat-card ' + (pendingOrders > 0 ? 'warning' : '') + '">' +
                '<span class="stat-icon"><i class="fas fa-clock"></i></span>' +
                '<div class="stat-number">' + pendingOrders + '</div><div class="stat-label">Pending</div></div>' +
        '</div>' +
        '<div class="admin-card"><div class="card-title"><span><i class="fas fa-chart-line"></i> Sales — Last 7 Days</span></div>' +
            '<div class="chart-container"><canvas id="salesChart"></canvas></div></div>' +
        lowStockHTML +
        '<div class="admin-card"><div class="card-title"><span><i class="fas fa-clock"></i> Recently Added</span></div>' +
            '<ul class="recent-list">' + recentProducts + '</ul></div>';

    if (window.Chart) {
        const ctx = document.getElementById('salesChart');
        if (salesChartInstance) { try { salesChartInstance.destroy(); } catch (e) {} salesChartInstance = null; }
        if (ctx) {
            salesChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: last7.map(function (d) { return d.label; }),
                    datasets: [{
                        label: 'Revenue (₦)',
                        data: last7.map(function (d) { return d.revenue; }),
                        borderColor: '#f9e508',
                        backgroundColor: 'rgba(249, 229, 8, 0.1)',
                        tension: 0.4, fill: true,
                        pointBackgroundColor: '#f9e508',
                        pointBorderColor: '#000',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#fff', font: { family: 'Poppins' } } } },
                    scales: {
                        x: { ticks: { color: 'rgba(255,255,255,0.6)' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                        y: { ticks: { color: 'rgba(255,255,255,0.6)', callback: function (v) { return '₦' + v.toLocaleString(); } },
                             grid: { color: 'rgba(255,255,255,0.05)' } }
                    }
                }
            });
        }
    }
}

// ============================================================
// PRODUCTS
// ============================================================
async function renderProducts(myToken) {
    if (typeof myToken !== 'number') myToken = viewToken;
    $('pageTitle').textContent = 'Products';
    currentSection = 'products';
    if (cachedProducts === null) cachedProducts = [];
    try { NakowaQueue.revokeAllPendingObjectUrls(); } catch (e) {}
    await drawProductsSection();
    try {
        const products = await apiGet('products');
        if (!isViewCurrent(myToken)) return;
        cachedProducts = products || [];
        if (currentSection === 'products') await drawProductsSection();
    } catch (e) { logOnce('products-refresh-failed', '[Products] refresh failed:', e); }
}

async function drawProductsSection() {
    const area = $('contentArea');
    if (!area) return;

    let pending = [];
    try {
        if (NakowaQueue.isAvailable()) pending = await NakowaQueue.getPendingProducts();
    } catch (e) { warnOnce('queue-pending-load', '[Queue] failed to load pending products:', e); }

    const pendingIds = new Set(pending.map(function (p) { return String(p.id); }));
    const backendOnly = (cachedProducts || []).filter(function (p) { return !pendingIds.has(String(p.id)); });
    window._nakowaMergedProducts = backendOnly.concat(pending);

    area.innerHTML =
        '<div class="admin-card">' +
            '<div class="card-title">' +
                '<span><i class="fas fa-box"></i> All Products (' + window._nakowaMergedProducts.length + ')</span>' +
                '<button class="btn-gold" id="addProductBtn"><i class="fas fa-plus"></i> Add Products</button>' +
            '</div>' +
            '<div class="admin-product-search">' +
                '<input type="text" id="productSearchInput" placeholder="Search by name or code..." />' +
            '</div>' +
            '<div id="bulkToolbar" class="bulk-toolbar hidden">' +
                '<span class="bulk-count"><span id="bulkCount">0</span> selected</span>' +
                '<select id="bulkPriceMode">' +
                    '<option value="set">Set Price To (₦)</option>' +
                    '<option value="add">Add (₦)</option>' +
                    '<option value="subtract">Subtract (₦)</option>' +
                    '<option value="increase_pct">Increase by (%)</option>' +
                    '<option value="decrease_pct">Decrease by (%)</option>' +
                '</select>' +
                '<input type="number" id="bulkPriceValue" placeholder="Value" min="0" />' +
                '<button class="btn-bulk-apply" id="bulkApplyPriceBtn"><i class="fas fa-tag"></i> Apply</button>' +
                '<button class="btn-bulk-delete" id="bulkDeleteBtn"><i class="fas fa-trash"></i> Delete Selected</button>' +
                '<button class="btn-bulk-cancel" id="bulkCancelBtn">Cancel</button>' +
            '</div>' +
            '<div id="productsContainer"></div>' +
        '</div>';

    $('addProductBtn').addEventListener('click', function () { renderAddProductForm(); });
    const searchInput = $('productSearchInput');
    searchInput.value = productSearchQuery;
    searchInput.addEventListener('input', function () {
        productSearchQuery = this.value.trim().toLowerCase();
        renderProductList('all');
    });
    $('bulkApplyPriceBtn').addEventListener('click', bulkApplyPrice);
    $('bulkDeleteBtn').addEventListener('click', bulkDeleteProducts);
    $('bulkCancelBtn').addEventListener('click', function () {
        selectedProductIds.clear();
        updateBulkToolbar();
        renderProductList('all');
    });
    renderProductList('all');
}

function updateBulkToolbar() {
    const toolbar = $('bulkToolbar');
    const countEl = $('bulkCount');
    if (!toolbar || !countEl) return;
    countEl.textContent = selectedProductIds.size;
    toolbar.classList.toggle('hidden', selectedProductIds.size === 0);
}

function renderProductList(filterCountry) {
    const container = $('productsContainer');
    if (!container) return;
    const merged = window._nakowaMergedProducts || [];

    const countries = [];
    merged.forEach(function (p) {
        if (p.country && countries.indexOf(p.country) === -1) countries.push(p.country);
    });
    if (countries.indexOf('Egypt') === -1) countries.unshift('Egypt');

    let filtered = filterCountry === 'all' ? merged.slice() : merged.filter(function (p) { return p.country === filterCountry; });
    if (productSearchQuery) {
        const q = productSearchQuery;
        filtered = filtered.filter(function (p) {
            const nameMatch = (p.name || '').toLowerCase().indexOf(q) !== -1;
            const codeMatch = (p.code || '').toLowerCase().indexOf(q) !== -1;
            const variantMatch = (p.variants || []).some(function (v) {
                return (v.colorName || '').toLowerCase().indexOf(q) !== -1 ||
                       (v.code || '').toLowerCase().indexOf(q) !== -1;
            });
            return nameMatch || codeMatch || variantMatch;
        });
    }

    const filterHTML = '<div class="filter-buttons" style="margin-bottom:14px;">' +
        '<button class="filter-btn ' + (filterCountry === 'all' ? 'active' : '') + '" data-filter="all">All</button>' +
        countries.map(function (c) {
            return '<button class="filter-btn ' + (filterCountry === c ? 'active' : '') + '" data-filter="' + escapeHtml(c) + '">' +
                (c === 'Egypt' ? '🇪🇬 ' : '') + escapeHtml(c) + '</button>';
        }).join('') + '</div>';

    if (filtered.length === 0) {
        container.innerHTML = filterHTML +
            '<div class="empty-state-admin"><i class="fas fa-box-open"></i><h4>No products</h4>' +
            '<p>' + (productSearchQuery ? 'No match for your search.' : 'Click "Add Products" to start.') + '</p></div>';
    } else {
        container.innerHTML = filterHTML +
            '<div class="admin-product-grid">' +
                filtered.map(function (p) { return renderAdminProductCard(p); }).join('') +
            '</div>';
    }

    container.querySelectorAll('.filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { renderProductList(btn.dataset.filter); });
    });
    container.querySelectorAll('.edit-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { editProduct(btn.dataset.id); });
    });
    container.querySelectorAll('.delete-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { deleteProduct(btn.dataset.id); });
    });
    container.querySelectorAll('.retry-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const jobId = btn.dataset.jobId;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Retrying...';
            NakowaQueue.retryFailedItems(jobId, { getToken: function () { return getToken(); } })
                .then(function (r) {
                    if (r && r.ok) showToast('Retrying failed items...', '🔁');
                    else { showToast((r && r.reason) || 'Retry failed', '❌'); btn.disabled = false; btn.innerHTML = '<i class="fas fa-redo"></i> Retry failed'; }
                })
                .catch(function (err) {
                    showToast('Retry error: ' + (err && err.message ? err.message : String(err)), '❌');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-redo"></i> Retry failed';
                });
        });
    });
    container.querySelectorAll('.card-checkbox').forEach(function (cb) {
        cb.addEventListener('change', function () {
            const id = this.dataset.id;
            if (this.checked) selectedProductIds.add(id); else selectedProductIds.delete(id);
            updateBulkToolbar();
            const card = this.closest('.admin-product-card');
            if (card) card.classList.toggle('selected', this.checked);
        });
    });
    updateBulkToolbar();
}

function renderAdminProductCard(p) {
    const variants = (p.variants && Array.isArray(p.variants)) ? p.variants : [];
    const firstVariant = variants[0] || {
        image: (Array.isArray(p.images) && p.images[0]) || p.images || '',
        price: p.price || 0, code: p.code || '', colorName: 'Default', colorValue: '#D4AF37'
    };
    const hasVideo = (p.videos && Array.isArray(p.videos) && p.videos.length > 0);
    const isPending = !!p._pending;
    const isSelected = selectedProductIds.has(String(p.id));

    let colorCirclesHTML = '';
    if (variants.length > 0) {
        colorCirclesHTML = '<div style="display:flex;gap:4px;flex-wrap:wrap;justify-content:center;margin:6px 0;">' +
            variants.slice(0, 6).map(function (v) {
                return '<span style="display:inline-block;width:14px;height:14px;border-radius:50%;' +
                    'background:' + escapeHtml(v.colorValue || '#ccc') + ';border:1px solid rgba(255,255,255,0.3);" ' +
                    'title="' + escapeHtml(v.colorName || '') + '"></span>';
            }).join('') +
            (variants.length > 6 ? '<span style="font-size:0.7rem;color:rgba(255,255,255,0.5);">+' + (variants.length - 6) + '</span>' : '') +
        '</div>';
    }

    let pendingBadge = '';
    let retryBtn = '';
    if (isPending) {
        const uploaded = p._uploadedCount || 0;
        const total = p._totalCount || variants.length;
        const state = p._queueState || 'queued';
        const label = state === 'error' ? '⚠️ Upload failed' : ('⏳ Uploading ' + uploaded + '/' + total);
        pendingBadge = '<div style="margin-top:6px;padding:4px 10px;border-radius:20px;display:inline-block;font-size:0.72rem;' +
            'background:' + (state === 'error' ? 'rgba(239,68,68,0.2)' : 'rgba(249,229,8,0.15)') + ';' +
            'color:' + (state === 'error' ? '#ef4444' : '#f9e508') + ';border:1px solid currentColor;">' + label + '</div>';
        if (state === 'error') {
            retryBtn = '<button class="retry-btn" data-job-id="' + escapeHtml(p.id) + '" ' +
                'style="margin-top:6px;padding:6px 12px;border-radius:20px;background:rgba(249,229,8,0.15);' +
                'color:#f9e508;border:1px solid #f9e508;cursor:pointer;font-size:0.75rem;">' +
                '<i class="fas fa-redo"></i> Retry failed</button>';
        }
    }

    const editDeleteBtns = isPending
        ? '<span style="opacity:0.5;font-size:0.75rem;">Waiting for upload to finish</span>'
        : '<button class="edit-btn" data-id="' + escapeHtml(p.id) + '"><i class="fas fa-edit"></i> Edit</button>' +
          '<button class="delete-btn" data-id="' + escapeHtml(p.id) + '"><i class="fas fa-trash"></i></button>';

    return '<div class="admin-product-card ' + (isSelected ? 'selected' : '') + '">' +
        '<input type="checkbox" class="card-checkbox" data-id="' + escapeHtml(p.id) + '" ' + (isSelected ? 'checked' : '') + ' />' +
        (hasVideo
            ? '<video src="' + escapeHtml(p.videos[0]) + '" muted autoplay loop playsinline ' +
              'style="width:100%;height:140px;object-fit:cover;border-radius:8px;margin-bottom:10px;" data-autoplay-video></video>'
            : '<img src="' + escapeHtml(firstVariant.image || DEFAULT_IMG_LOCAL) + '" alt="' + escapeHtml(p.name) + '" onerror="imgFallback(this)" />') +
        '<h4>' + escapeHtml(p.name) + '</h4>' +
        '<div class="product-meta">Code: <strong>' + escapeHtml(firstVariant.code || p.code || '') + '</strong></div>' +
        '<div class="product-price" style="text-align:left;margin:4px 0;font-size:0.95rem;">' + renderPrice(firstVariant.price || p.price || 0) + '</div>' +
        '<div class="product-meta">Stock: <strong>' + (p.stock || 0) + '</strong></div>' +
        '<div class="product-meta">Colors: ' + variants.length + (hasVideo ? ' · 🎬 Video' : '') + '</div>' +
        colorCirclesHTML + pendingBadge + retryBtn +
        '<div class="admin-actions">' + editDeleteBtns + '</div>' +
    '</div>';
}

// ============================================================
// BULK PRICE (per variant)
// ============================================================
async function bulkApplyPrice() {
    if (selectedProductIds.size === 0) { showToast('Select products first', '⚠️'); return; }
    const mode = $('bulkPriceMode').value;
    const value = parseFloat($('bulkPriceValue').value);
    if (isNaN(value) || value < 0) { showToast('Enter a valid value', '⚠️'); return; }

    const updates = [];
    selectedProductIds.forEach(function (id) {
        const p = (cachedProducts || []).find(function (x) { return String(x.id) === String(id); });
        if (!p) return;
        const variants = Array.isArray(p.variants) ? p.variants : [];
        const newVariants = variants.map(function (v) {
            const current = parseFloat(v.price) || 0;
            let next = current;
            switch (mode) {
                case 'set': next = value; break;
                case 'add': next = current + value; break;
                case 'subtract': next = Math.max(0, current - value); break;
                case 'increase_pct': next = Math.round(current * (1 + value / 100)); break;
                case 'decrease_pct': next = Math.round(current * (1 - value / 100)); break;
            }
            return Object.assign({}, v, { price: Math.max(0, next) });
        });
        const prices = newVariants.length ? newVariants.map(function (v) { return v.price; }) : [parseFloat(p.price) || 0];
        const avg = Math.round(prices.reduce(function (a, b) { return a + b; }, 0) / prices.length);
        updates.push({ id: p.id, newPrice: avg, variants: newVariants });
    });
    if (updates.length === 0) return;

    showToast('Updating ' + updates.length + ' product(s)...', '⏳');
    try {
        const res = await apiPost('bulkUpdatePrices', {
            token: authToken,
            updates: updates.map(function (u) { return { id: u.id, newPrice: u.newPrice }; })
        });
        if (!res || !res.success) { showToast((res && res.message) || 'Update failed', '❌'); return; }

        updates.forEach(function (u) {
            const idx = cachedProducts.findIndex(function (p) { return String(p.id) === String(u.id); });
            if (idx >= 0) cachedProducts[idx].variants = u.variants;
        });

        const productsToSave = updates.map(function (u) {
            return cachedProducts.find(function (x) { return String(x.id) === String(u.id); });
        }).filter(Boolean);
        if (productsToSave.length > 0) {
            await apiPost('saveProductsBatch', { token: authToken, products: productsToSave })
                .catch(function (err) { warnOnce('bulk-price-save-batch', '[BulkPrice] saveProductsBatch failed:', err); });
        }
        showToast(updates.length + ' product(s) updated!', '✅');
        selectedProductIds.clear();
        drawProductsSection();
    } catch (err) { showToast('Error: ' + err.message, '❌'); }
}

// ============================================================
// BULK DELETE
// ============================================================
async function bulkDeleteProducts() {
    if (selectedProductIds.size === 0) { showToast('Select products first', '⚠️'); return; }
    const count = selectedProductIds.size;
    const ids = Array.from(selectedProductIds);
    const backendIds = ids.filter(function (id) {
        return (cachedProducts || []).some(function (p) { return String(p.id) === String(id); });
    });
    const pendingIds = ids.filter(function (id) { return backendIds.indexOf(id) === -1; });

    showConfirm('Delete ' + count + ' product(s)?', 'This action cannot be undone.', async function () {
        try {
            if (backendIds.length > 0) {
                const res = await apiPost('bulkDeleteProducts', { token: authToken, ids: backendIds });
                if (!res || !res.success) { showToast((res && res.message) || 'Delete failed', '❌'); return; }
                cachedProducts = cachedProducts.filter(function (p) { return !selectedProductIds.has(String(p.id)); });
            }
            for (let i = 0; i < pendingIds.length; i++) {
                try { await NakowaQueue.deleteJob(pendingIds[i]); } catch (e) {}
            }
            showToast(count + ' product(s) deleted', '🗑️');
            selectedProductIds.clear();
            updateBulkToolbar();
            drawProductsSection();
        } catch (err) { showToast('Error: ' + err.message, '❌'); }
    });
}

// ============================================================
// ADD PRODUCT — category → media → variants
// ============================================================
function renderAddProductForm() {
    const container = $('productsContainer');
    if (!container) return;
    try { NakowaQueue.revokeAllPendingObjectUrls(); } catch (e) {}
    uploadFiles = [];
    currentVariantIndex = 0;
    currentBatch = [];

    container.innerHTML =
        '<div class="admin-card" id="addProductCard">' +
            '<div class="card-title">' +
                '<span><i class="fas fa-plus"></i> Add New Products</span>' +
                '<button class="btn-outline-gold" id="cancelAddBtn">Cancel</button>' +
            '</div>' +
            '<div id="stepCategory">' +
                '<p style="margin-bottom:12px;color:rgba(255,255,255,0.6);">Step 1: Choose category</p>' +
                '<div class="filter-buttons"><button class="filter-btn active" data-cat="Egypt">🇪🇬 Egypt</button></div>' +
                '<button class="btn-gold" id="toStepMediaBtn" style="margin-top:16px;">Next: Upload Media</button>' +
            '</div>' +
            '<div id="stepMedia" style="display:none;">' +
                '<p style="margin-bottom:12px;color:rgba(255,255,255,0.6);">Step 2: Upload images and/or videos. Drag to reorder (first = main thumbnail).</p>' +
                '<div class="upload-zone" id="uploadZone">' +
                    '<i class="fas fa-cloud-upload-alt"></i>' +
                    '<p>Click to select files</p>' +
                    '<div class="upload-hint">Supports JPG, PNG, WEBP, MP4, MOV, WEBM</div>' +
                    '<input type="file" id="fileInput" accept="image/*,video/*" multiple />' +
                '</div>' +
                '<div class="admin-upload-preview" id="uploadPreview"></div>' +
                '<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">' +
                    '<button class="btn-gold" id="startVariantsBtn" disabled>Start Variant Setup</button>' +
                    '<button class="btn-outline-gold" id="backToCatBtn">Back</button>' +
                '</div>' +
            '</div>' +
            '<div id="stepVariants" style="display:none;"><div id="variantStepContainer"></div></div>' +
        '</div>';

    $('cancelAddBtn').addEventListener('click', function () {
        try { NakowaQueue.revokeAllPendingObjectUrls(); } catch (e) {}
        renderProducts();
    });
    $('toStepMediaBtn').addEventListener('click', function () {
        $('stepCategory').style.display = 'none';
        $('stepMedia').style.display = 'block';
    });
    $('backToCatBtn').addEventListener('click', function () {
        $('stepMedia').style.display = 'none';
        $('stepCategory').style.display = 'block';
    });

    const uploadZone = $('uploadZone');
    const fileInput = $('fileInput');
    uploadZone.addEventListener('click', function () { fileInput.click(); });
    fileInput.addEventListener('change', function (e) {
        handleFileSelection(e.target.files);
        e.target.value = '';
    });
    uploadZone.addEventListener('dragover', function (e) { e.preventDefault(); uploadZone.classList.add('dragover'); });
    uploadZone.addEventListener('dragleave', function () { uploadZone.classList.remove('dragover'); });
    uploadZone.addEventListener('drop', function (e) {
        e.preventDefault();
        uploadZone.classList.remove('dragover');
        handleFileSelection(e.dataTransfer.files);
    });
    $('startVariantsBtn').addEventListener('click', startVariantSetup);
}

function handleFileSelection(files) {
    if (!files || files.length === 0) return;
    const incoming = Array.from(files).filter(function (f) {
        return f.type.indexOf('image/') === 0 || f.type.indexOf('video/') === 0;
    });
    if (incoming.length + uploadFiles.length > 100) { showToast('Maximum 100 files per batch', '⚠️'); return; }
    uploadFiles = uploadFiles.concat(incoming.map(function (f) {
        return { file: f, isVideo: f.type.indexOf('video/') === 0, url: null };
    }));
    renderUploadPreview();
}

function renderUploadPreview() {
    const preview = $('uploadPreview');
    if (!preview) return;

    // Revoke old object URLs before rebuilding.
    preview.querySelectorAll('img,video').forEach(function (el) {
        if (el._blobUrl) { try { URL.revokeObjectURL(el._blobUrl); } catch (e) {} }
    });

    preview.innerHTML = uploadFiles.map(function (item, i) {
        const url = URL.createObjectURL(item.file);
        if (item.isVideo) {
            return '<div class="preview-item" data-idx="' + i + '" draggable="true">' +
                '<video data-blob-url="' + url + '" src="' + url + '" muted autoplay loop playsinline data-autoplay-video></video>' +
                '<button class="remove-img" data-remove="' + i + '">×</button></div>';
        }
        return '<div class="preview-item" data-idx="' + i + '" draggable="true">' +
            '<img data-blob-url="' + url + '" src="' + url + '" alt="" />' +
            '<button class="remove-img" data-remove="' + i + '">×</button></div>';
    }).join('');

    // Track blob URLs so we can revoke them later.
    preview.querySelectorAll('[data-blob-url]').forEach(function (el) {
        el._blobUrl = el.dataset.blobUrl;
    });

    preview.querySelectorAll('[data-remove]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            const i = parseInt(btn.dataset.remove, 10);
            uploadFiles.splice(i, 1);
            renderUploadPreview();
        });
    });

    setupDragReorder(preview);
    applyVideo10sLoop(preview);

    const btn = $('startVariantsBtn');
    if (btn) btn.disabled = uploadFiles.length === 0;
}

function setupDragReorder(container) {
    let dragIdx = null;
    container.querySelectorAll('.preview-item').forEach(function (item) {
        item.addEventListener('dragstart', function (e) {
            dragIdx = parseInt(this.dataset.idx, 10);
            this.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
        });
        item.addEventListener('dragend', function () {
            this.classList.remove('dragging');
            container.querySelectorAll('.preview-item').forEach(function (x) { x.classList.remove('drag-over'); });
        });
        item.addEventListener('dragover', function (e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            this.classList.add('drag-over');
        });
        item.addEventListener('dragleave', function () { this.classList.remove('drag-over'); });
        item.addEventListener('drop', function (e) {
            e.preventDefault();
            this.classList.remove('drag-over');
            const dropIdx = parseInt(this.dataset.idx, 10);
            if (dragIdx === null || dragIdx === dropIdx) return;
            const moved = uploadFiles.splice(dragIdx, 1)[0];
            uploadFiles.splice(dropIdx, 0, moved);
            dragIdx = null;
            renderUploadPreview();
        });
    });
}

// ============================================================
// VARIANT SETUP
// ============================================================
function startVariantSetup() {
    if (uploadFiles.length === 0) { showToast('Please select files first', '⚠️'); return; }
    currentVariantIndex = 0;
    currentBatch = uploadFiles.map(function (f) {
        return {
            file: f.file, isVideo: f.isVideo, url: null,
            price: '', code: '', colorName: '', colorValue: ''
        };
    });
    $('stepMedia').style.display = 'none';
    $('stepVariants').style.display = 'block';
    renderVariantStep();
}

function attachCodeInputCleaner(inputId) {
    const el = document.getElementById(inputId);
    if (!el || el._cleanerAttached) return;
    el._cleanerAttached = true;
    el.addEventListener('input', function () {
        const cleaned = this.value.replace(/^NAK-/i, '');
        if (cleaned !== this.value) this.value = cleaned;
    });
}

function renderVariantStep() {
    const container = $('variantStepContainer');
    const v = currentBatch[currentVariantIndex];
    const total = currentBatch.length;
    const idx = currentVariantIndex;
    if (!v) return;

    // Revoke previous object URL in this step.
    if (container._blobUrl) {
        try { URL.revokeObjectURL(container._blobUrl); } catch (e) {}
        container._blobUrl = null;
    }
    const url = URL.createObjectURL(v.file);
    container._blobUrl = url;

    container.innerHTML =
        '<div class="variant-step-container">' +
            '<div class="variant-step-counter"><i class="fas ' + (v.isVideo ? 'fa-video' : 'fa-image') + '"></i> ' +
                (v.isVideo ? 'Video' : 'Image') + ' — Variant ' + (idx + 1) + ' of ' + total + '</div>' +
            (v.isVideo
                ? '<video src="' + url + '" class="variant-preview" muted autoplay loop playsinline data-autoplay-video></video>'
                : '<img src="' + url + '" class="variant-preview" alt="" />') +
            '<div class="variant-inputs">' +
                '<div><label>Price (₦) <span style="color:#e74c3c;">*</span></label>' +
                    '<input type="number" id="vPrice" placeholder="e.g. 35000" value="' + (v.price || '') + '" /></div>' +
                '<div><label>Product Code <span style="color:#e74c3c;">*</span></label>' +
                    '<input type="text" id="vCode" inputmode="numeric" pattern="[0-9]*" placeholder="e.g. 001" value="' + escapeHtml(v.code || '') + '" autocomplete="off" spellcheck="false" /></div>' +
                (!v.isVideo
                    ? '<div><label>Color <span style="color:#e74c3c;">*</span></label>' +
                        '<div class="color-picker-grid" id="colorPicker">' +
                            COLOR_PALETTE.map(function (c) {
                                return '<button type="button" class="color-picker-circle ' + (v.colorValue === c.value ? 'selected' : '') + '" ' +
                                    'data-color-name="' + escapeHtml(c.name) + '" data-color-value="' + escapeHtml(c.value) + '" ' +
                                    'style="background-color: ' + escapeHtml(c.value) + ';" title="' + escapeHtml(c.name) + '"></button>';
                            }).join('') +
                        '</div>' +
                        '<div class="selected-color-display" id="selectedColorDisplay">' +
                            (v.colorName
                                ? '<span class="selected-color-swatch" style="background-color:' + escapeHtml(v.colorValue) + ';"></span> Selected: ' + escapeHtml(v.colorName)
                                : 'No color selected yet') +
                        '</div></div>'
                    : '') +
            '</div>' +
            '<div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:8px;">' +
                (idx > 0 ? '<button class="btn-outline-gold" id="prevVariantBtn">← Previous</button>' : '') +
                (idx < total - 1
                    ? '<button class="btn-gold" id="nextVariantBtn">Next →</button>'
                    : '<button class="btn-gold" id="saveBatchBtn"><i class="fas fa-save"></i> Save All</button>') +
            '</div>' +
        '</div>';

    attachCodeInputCleaner('vCode');
    const colorPicker = $('colorPicker');
    if (colorPicker) {
        colorPicker.querySelectorAll('.color-picker-circle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                colorPicker.querySelectorAll('.color-picker-circle').forEach(function (b) { b.classList.remove('selected'); });
                this.classList.add('selected');
                v.colorName = this.dataset.colorName;
                v.colorValue = this.dataset.colorValue;
                $('selectedColorDisplay').innerHTML = '<span class="selected-color-swatch" style="background-color:' + escapeHtml(v.colorValue) + ';"></span> Selected: ' + escapeHtml(v.colorName);
            });
        });
    }
    const prevBtn = $('prevVariantBtn');
    if (prevBtn) prevBtn.addEventListener('click', function () {
        if (!saveCurrentVariant()) return;
        currentVariantIndex--;
        renderVariantStep();
    });
    const nextBtn = $('nextVariantBtn');
    if (nextBtn) nextBtn.addEventListener('click', function () {
        if (!saveCurrentVariant()) return;
        currentVariantIndex++;
        renderVariantStep();
    });
    const saveBtn = $('saveBatchBtn');
    if (saveBtn) saveBtn.addEventListener('click', function () {
        if (!saveCurrentVariant()) return;
        saveBatch();
    });
    applyVideo10sLoop(container);
}

function saveCurrentVariant() {
    const v = currentBatch[currentVariantIndex];
    const price = parseFloat($('vPrice').value);
    const code = $('vCode').value.trim();
    if (!price || price <= 0) { showToast('Please enter a valid price', '⚠️'); return false; }
    if (!code) { showToast('Please enter a product code', '⚠️'); return false; }
    if (!v.isVideo && !v.colorName) { showToast('Please select a color', '⚠️'); return false; }
    v.price = price;
    v.code = normalizeProductCode(code);
    if (v.isVideo && !v.colorName) { v.colorName = 'Default'; v.colorValue = '#D4AF37'; }
    return true;
}

// ============================================================
// SAVE BATCH — queue-first
// ============================================================
async function saveBatch() {
    if (!currentBatch.length) { showToast('No files selected', '⚠️'); return; }
    const saveBtn = $('saveBatchBtn');
    if (saveBtn) { saveBtn.disabled = true; saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...'; }

    try {
        const firstCode = (currentBatch[0] && currentBatch[0].code) || '000';
        const productId = NakowaQueue.newJobId('P');

        // Build the job.
        const items = currentBatch.map(function (v) {
            return {
                blob: v.file,
                price: v.price,
                code: (v.code || '').toString().trim(),
                colorName: v.colorName || 'Default',
                colorValue: v.colorValue || '#D4AF37',
                isVideo: !!v.isVideo,
                status: 'queued',
                attempts: 0,
                url: ''
            };
        });
        const job = {
            id: productId,
            name: 'NAKOWA ABAYA',
            code: firstCode,
            country: 'Egypt',
            sizes: ['S', 'M', 'L', 'XL', 'XXL'],
            stock: 10,
            status: 'active',
            createdAt: new Date().toISOString(),
            state: 'queued',
            uploadedCount: 0,
            totalCount: items.length,
            lastError: '',
            items: items
        };

        const queueAvailable = NakowaQueue.isAvailable();

        if (queueAvailable) {
            try {
                await NakowaQueue.putJob(job);
            } catch (err) {
                if (err && err.message === 'QUOTA_EXCEEDED') {
                    showToast('Storage full. Delete some photos or clear the queue, then try again.', '⚠️');
                    if (saveBtn) { saveBtn.disabled = false; saveBtn.innerHTML = '<i class="fas fa-save"></i> Save All'; }
                    return;
                }
                throw err;
            }
            showToast('Saved! Uploading in background...', '✅');
        } else {
            // Fallback: no IndexedDB. Do a direct upload in the background.
            showToast('IndexedDB unavailable — uploading directly...', '⚠️');
        }

        try { NakowaQueue.revokeAllPendingObjectUrls(); } catch (e) {}
        currentBatch = [];
        uploadFiles = [];

        // Show the products list right away — the pending card appears
        // immediately because drawProductsSection reads from IndexedDB.
        if (currentSection === 'products') {
            await drawProductsSection();
        } else {
            loadSection('products');
        }

        if (queueAvailable) {
            NakowaQueue.startWorker({ getToken: function () { return getToken(); } }).catch(function (err) {
                warnOnce('save-batch-worker', '[Save] Worker start failed:', err);
            });
        } else {
            // Direct fallback (rare): upload right now, no queue.
            directUploadFallback(job);
        }
    } catch (err) {
        logOnce('batch-fatal-' + err.message, '[Batch] Failed: ' + err.message);
        showToast('Save failed: ' + (err.message || String(err)).substring(0, 140), '❌');
        if (saveBtn) { saveBtn.disabled = false; saveBtn.innerHTML = '<i class="fas fa-save"></i> Save All'; }
    }
}

// Direct-upload fallback when IndexedDB is unavailable.
async function directUploadFallback(job) {
    try {
        const stats = await NakowaQueue.getSupabaseStats();
        const products = [];
        const images = [];
        const videos = [];
        for (let i = 0; i < job.items.length; i++) {
            const it = job.items[i];
            try {
                const url = await NakowaQueue.uploadOne(it.blob, it.isVideo, i, job.items.length, stats);
                if (it.isVideo) videos.push(url);
                else images.push({ image: url, colorName: it.colorName, colorValue: it.colorValue, price: it.price, code: it.code });
            } catch (err) {
                warnOnce('direct-upload-item-' + i, '[Direct] item failed:', err);
            }
        }
        products.push({
            id: job.id, name: job.name, code: job.code, country: job.country,
            sizes: job.sizes, variants: images, images: images.map(function (v) { return v.image; }),
            videos: videos, stock: job.stock, status: job.status, createdAt: job.createdAt
        });
        const res = await apiPost('saveProductsBatch', { token: authToken, products: products });
        if (true) {
            showToast('Direct upload complete!', '✅');
            const fresh = await apiGet('products');
            cachedProducts = fresh || cachedProducts;
            if (currentSection === 'products') drawProductsSection();
        }
    } catch (err) {
        showToast('Direct upload failed: ' + (err && err.message ? err.message : String(err)), '❌');
    }
}

// ============================================================
// EDIT PRODUCT
// ============================================================
async function editProduct(id) {
    const p = cachedProducts.find(function (x) { return String(x.id) === String(id); });
    if (!p) { showToast('Product not found', '❌'); return; }
    const variants = (p.variants && Array.isArray(p.variants)) ? p.variants : [];
    const sizes = Array.isArray(p.sizes) ? p.sizes.join(', ') : (p.sizes || '');

    const container = $('productsContainer');
    container.innerHTML =
        '<div class="admin-card">' +
            '<div class="card-title"><span><i class="fas fa-edit"></i> Edit: ' + escapeHtml(p.name) + '</span>' +
            '<button class="btn-outline-gold" id="cancelEditBtn">Cancel</button></div>' +
            '<form class="admin-form" id="editForm">' +
                '<div class="form-group"><label>Product Name <span class="required">*</span></label>' +
                    '<input type="text" id="editName" value="' + escapeHtml(p.name) + '" required /></div>' +
                '<div class="form-row">' +
                    '<div class="form-group"><label>Code <span class="required">*</span></label>' +
                        '<input type="text" id="editCode" value="' + escapeHtml(p.code || '') + '" required /></div>' +
                    '<div class="form-group"><label>Sizes (comma-separated)</label>' +
                        '<input type="text" id="editSizes" value="' + escapeHtml(sizes) + '" /></div>' +
                '</div>' +
                '<div class="form-row">' +
                    '<div class="form-group"><label>Stock</label>' +
                        '<input type="number" id="editStock" value="' + parseInt(p.stock || 0, 10) + '" min="0" /></div>' +
                    '<div class="form-group"><label>Status</label>' +
                        '<select id="editStatus">' +
                            '<option value="active" ' + (p.status === 'active' ? 'selected' : '') + '>Active</option>' +
                            '<option value="inactive" ' + (p.status === 'inactive' ? 'selected' : '') + '>Inactive</option>' +
                        '</select></div>' +
                '</div>' +
                '<div class="card-title" style="font-size:1rem;margin-top:12px;"><span>Variants (' + variants.length + ')</span></div>' +
                '<div id="editVariantsList">' +
                    variants.map(function (v, i) {
                        return '<div style="display:flex;gap:10px;align-items:center;padding:10px;background:rgba(255,255,255,0.03);border-radius:10px;margin-bottom:8px;border:1px solid var(--border-gold);">' +
                            '<img src="' + escapeHtml(v.image) + '" style="width:60px;height:60px;object-fit:cover;border-radius:8px;border:1px solid var(--border-gold);" onerror="imgFallback(this)" />' +
                            '<div style="flex:1;">' +
                                '<div style="color:var(--gold);font-weight:600;font-size:0.85rem;">' +
                                    '<span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:' + escapeHtml(v.colorValue) + ';vertical-align:middle;margin-right:6px;border:1px solid #fff;"></span>' +
                                    escapeHtml(v.colorName) + '</div>' +
                                '<div style="font-size:0.75rem;color:rgba(255,255,255,0.6);">Code: ' + escapeHtml(v.code) + '</div>' +
                            '</div>' +
                            '<div style="display:flex;flex-direction:column;gap:4px;">' +
                                '<input type="number" class="edit-v-price" data-idx="' + i + '" value="' + (v.price || 0) + '" placeholder="Price" style="width:100px;padding:6px 8px;border-radius:6px;border:1px solid var(--border-gold);background:rgba(255,255,255,0.06);color:#fff;font-size:0.8rem;" />' +
                                '<input type="text" class="edit-v-code" data-idx="' + i + '" value="' + escapeHtml(v.code) + '" placeholder="Code" style="width:100px;padding:6px 8px;border-radius:6px;border:1px solid var(--border-gold);background:rgba(255,255,255,0.06);color:#fff;font-size:0.8rem;" />' +
                            '</div></div>';
                    }).join('') +
                '</div>' +
                '<div class="form-actions"><button type="submit" class="btn-gold"><i class="fas fa-save"></i> Save Changes</button></div>' +
            '</form></div>';

    attachCodeInputCleaner('editCode');
    document.querySelectorAll('.edit-v-code').forEach(function (el) {
        if (el._cleanerAttached) return;
        el._cleanerAttached = true;
        el.addEventListener('input', function () {
            const c = this.value.replace(/^NAK-/i, '');
            if (c !== this.value) this.value = c;
        });
    });
    $('cancelEditBtn').addEventListener('click', function () { drawProductsSection(); });

    $('editForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const newName = $('editName').value.trim();
        const newCode = $('editCode').value.trim();
        const newSizesStr = $('editSizes').value.trim();
        const newStock = parseInt($('editStock').value, 10) || 0;
        const newStatus = $('editStatus').value;
        if (!newName || !newCode) { showToast('Name and Code are required', '⚠️'); return; }

        const newVariants = variants.map(function (v, i) {
            const priceEl = document.querySelector('.edit-v-price[data-idx="' + i + '"]');
            const codeEl = document.querySelector('.edit-v-code[data-idx="' + i + '"]');
            return Object.assign({}, v, {
                price: parseFloat(priceEl.value) || v.price,
                code: normalizeProductCode(codeEl.value.trim()) || v.code
            });
        });
        const updated = Object.assign({}, p, {
            name: newName,
            code: normalizeProductCode(newCode),
            sizes: newSizesStr.split(',').map(function (s) { return s.trim(); }).filter(Boolean),
            stock: newStock,
            status: newStatus,
            variants: newVariants
        });

        try {
            const res = await apiPost('updateProduct', { token: authToken, product: updated });
            if (res && res.success) {
                const idx = cachedProducts.findIndex(function (x) { return String(x.id) === String(p.id); });
                if (idx >= 0) cachedProducts[idx] = updated;
                showToast('Product updated!', '✅');
                drawProductsSection();
            } else {
                showToast((res && res.message) || 'Failed to update', '❌');
            }
        } catch (err) { showToast('Error: ' + err.message, '❌'); }
    });
}

// ============================================================
// DELETE PRODUCT
// ============================================================
async function deleteProduct(id) {
    showConfirm('Delete this product?', 'This action cannot be undone.', async function () {
        try {
            const res = await apiPost('deleteProduct', { token: authToken, id: id });
            if (res && res.success) {
                cachedProducts = cachedProducts.filter(function (p) { return String(p.id) !== String(id); });
                showToast('Product deleted', '🗑️');
                drawProductsSection();
            } else { showToast((res && res.message) || 'Failed', '❌'); }
        } catch (err) { showToast('Error: ' + err.message, '❌'); }
    });
}

// ============================================================
// ORDERS
// ============================================================
async function renderOrders(myToken) {
    if (typeof myToken !== 'number') myToken = viewToken;
    $('pageTitle').textContent = 'Orders';
    currentSection = 'orders';
    if (cachedOrders === null) cachedOrders = [];
    drawOrdersSection();
    try {
        const orders = await apiGet('orders');
        if (!isViewCurrent(myToken)) return;
        cachedOrders = (orders || []).reverse();
        if (currentSection === 'orders') drawOrdersSection();
    } catch (e) { logOnce('orders-refresh-failed', '[Orders] refresh failed:', e); }
}

function drawOrdersSection() {
    const area = $('contentArea');
    if (cachedOrders.length === 0) {
        area.innerHTML = '<div class="empty-state-admin"><i class="fas fa-shopping-bag"></i><h4>No orders yet</h4><p>Orders will appear here after customers place them.</p></div>';
        return;
    }
    area.innerHTML =
        '<div class="admin-card">' +
            '<div class="card-title"><span><i class="fas fa-shopping-bag"></i> All Orders (' + cachedOrders.length + ')</span></div>' +
            '<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px;">' +
                '<input type="text" id="orderSearch" placeholder="Search by ID, name, phone..." style="flex:1;min-width:200px;padding:10px 14px;border-radius:30px;border:1px solid var(--border-gold);background:rgba(255,255,255,0.06);color:#fff;font-size:16px;" />' +
                '<select id="orderStatusFilter" style="padding:10px 14px;border-radius:30px;border:1px solid var(--border-gold);background:rgba(255,255,255,0.06);color:#fff;font-size:16px;">' +
                    '<option value="all">All Statuses</option>' +
                    '<option value="pending">Pending</option>' +
                    '<option value="confirmed">Confirmed</option>' +
                    '<option value="processing">Processing</option>' +
                    '<option value="completed">Completed</option>' +
                    '<option value="cancelled">Cancelled</option>' +
                '</select>' +
            '</div>' +
            '<div class="orders-table-wrap"><table class="orders-table">' +
                '<thead><tr><th>Image</th><th>Order ID</th><th>Customer</th><th>Product</th>' +
                '<th>Color / Size</th><th>Qty</th><th>Total</th><th>Status</th><th>Notify</th><th>Receipt</th></tr></thead>' +
                '<tbody id="ordersTableBody"></tbody>' +
            '</table></div>' +
        '</div>';
    renderOrdersTable(cachedOrders);
    $('orderSearch').addEventListener('input', filterOrders);
    $('orderStatusFilter').addEventListener('change', filterOrders);
}

function filterOrders() {
    const q = $('orderSearch').value.trim().toLowerCase();
    const status = $('orderStatusFilter').value;
    let filtered = cachedOrders;
    if (q) filtered = filtered.filter(function (o) {
        return String(o.orderId || '').toLowerCase().indexOf(q) !== -1 ||
               String(o.customerName || '').toLowerCase().indexOf(q) !== -1 ||
               String(o.customerPhone || '').toLowerCase().indexOf(q) !== -1;
    });
    if (status !== 'all') filtered = filtered.filter(function (o) { return o.status === status; });
    renderOrdersTable(filtered);
}

function renderOrdersTable(orders) {
    const tbody = $('ordersTableBody');
    if (!tbody) return;
    if (orders.length === 0) {
        tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:30px;color:rgba(255,255,255,0.4);">No matching orders</td></tr>';
        return;
    }
    tbody.innerHTML = orders.map(function (o) {
        return '<tr>' +
            '<td><img src="' + escapeHtml(o.productImage || DEFAULT_IMG_LOCAL) + '" alt="" onerror="imgFallback(this)" /></td>' +
            '<td><strong style="color:var(--gold);">' + escapeHtml(o.orderId) + '</strong><br><span style="font-size:0.7rem;opacity:0.6;">' + escapeHtml(o.date) + ' ' + escapeHtml(o.time || '') + '</span></td>' +
            '<td>' + escapeHtml(o.customerName) + '<br><span style="font-size:0.75rem;opacity:0.6;">' + escapeHtml(o.customerPhone) + '</span></td>' +
            '<td>' + escapeHtml(o.productName) + '<br><span style="font-size:0.75rem;opacity:0.6;">Code: ' + escapeHtml(o.productCode) + '</span></td>' +
            '<td>' + escapeHtml(o.colorName) + ' / ' + escapeHtml(o.size) + '</td>' +
            '<td>' + (o.quantity || 1) + '</td>' +
            '<td><strong>' + formatMoney(o.total) + '</strong></td>' +
            '<td><select class="status-select" data-order-id="' + escapeHtml(o.orderId) + '">' +
                ['pending', 'confirmed', 'processing', 'completed', 'cancelled'].map(function (s) {
                    return '<option value="' + s + '" ' + (o.status === s ? 'selected' : '') + '>' + s + '</option>';
                }).join('') +
            '</select></td>' +
            '<td>' + (o.customerPhone
                ? '<button class="btn-outline-gold notify-btn" data-order-id="' + escapeHtml(o.orderId) + '" data-phone="' + escapeHtml(o.customerPhone) + '" data-status="' + escapeHtml(o.status || '') + '" style="padding:6px 10px;font-size:0.7rem;"><i class="fab fa-whatsapp"></i></button>'
                : '<span style="opacity:0.4;font-size:0.7rem;">—</span>') + '</td>' +
            '<td><button class="btn-outline-gold receipt-btn" data-order-id="' + escapeHtml(o.orderId) + '" style="padding:6px 10px;font-size:0.7rem;"><i class="fas fa-receipt"></i></button></td>' +
        '</tr>';
    }).join('');

    tbody.querySelectorAll('.status-select').forEach(function (sel) {
        sel.addEventListener('change', async function () {
            const orderId = this.dataset.orderId;
            const newStatus = this.value;
            try {
                const res = await apiPost('updateOrderStatus', { token: authToken, orderId: orderId, status: newStatus });
                if (res && res.success) {
                    const idx = cachedOrders.findIndex(function (o) { return o.orderId === orderId; });
                    if (idx >= 0) cachedOrders[idx].status = newStatus;
                    const notifyBtn = tbody.querySelector('.notify-btn[data-order-id="' + orderId + '"]');
                    if (notifyBtn) notifyBtn.dataset.status = newStatus;
                    showToast('Status updated. Click the WhatsApp icon to notify the customer.', '✅');
                } else { showToast((res && res.message) || 'Failed', '❌'); }
            } catch (err) { showToast('Error: ' + err.message, '❌'); }
        });
    });

    // WhatsApp notify — opens ONLY on direct user click (no await
    // before window.open, so mobile blockers do not fire).
    tbody.querySelectorAll('.notify-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const orderId = this.dataset.orderId;
            const phone = this.dataset.phone;
            const status = this.dataset.status || 'pending';
            const cleanPhone = String(phone || '').replace(/\D/g, '');
            if (!cleanPhone) { showToast('No phone number on this order', '⚠️'); return; }
            const msg = '🛍️ *NAKOWA ABAYAS COLLECTIONS*\n\nYour order ' + orderId +
                ' status is now: *' + status.toUpperCase() + '*\n\nThank you for shopping with us!';
            const waUrl = 'https://wa.me/' + cleanPhone + '?text=' + encodeURIComponent(msg);
            window.open(waUrl, '_blank');
        });
    });

    tbody.querySelectorAll('.receipt-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { generateReceipt(btn.dataset.orderId); });
    });
}

// ============================================================
// PDF RECEIPT
// ============================================================
async function generateReceipt(orderId) {
    const o = cachedOrders.find(function (x) { return x.orderId === orderId; });
    if (!o) { showToast('Order not found', '❌'); return; }

    const jspdfLib = window.jspdf;
    if (!jspdfLib) { showToast('PDF library not loaded', '❌'); return; }
    const doc = new jspdfLib.jsPDF({ orientation: 'portrait', unit: 'mm', format: [80, 200] });
    const W = 80, margin = 5, contentW = W - margin * 2;

    doc.setFillColor(0, 0, 0);
    doc.rect(0, 0, W, 22, 'F');
    doc.setTextColor(249, 229, 8);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(11);
    doc.text('NAKOWA ABAYAS', W / 2, 10, { align: 'center' });
    doc.setFontSize(7);
    doc.setFont('helvetica', 'normal');
    doc.setTextColor(255, 255, 255);
    doc.text('COLLECTIONS', W / 2, 15, { align: 'center' });
    doc.setFontSize(6);
    doc.text('Order Receipt', W / 2, 19, { align: 'center' });

    doc.setTextColor(0, 0, 0);
    doc.setFontSize(8);
    doc.setFont('helvetica', 'bold');
    let y = 30;
    doc.text('Order ID:', margin, y);
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(7);
    const idParts = formatOrderIdDisplay(o.orderId, o.productCode);
    doc.text(idParts.code || '', margin, y + 4);
    if (idParts.date) doc.text(idParts.date, margin, y + 8);
    y += 14;
    doc.setDrawColor(0, 0, 0);
    doc.setLineWidth(0.2);
    doc.line(margin, y, W - margin, y);
    y += 5;
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(7);
    doc.text('Customer', margin, y); y += 4;
    doc.setFont('helvetica', 'normal');
    doc.text(o.customerName || '-', margin, y); y += 4;
    doc.text(o.customerPhone || '-', margin, y); y += 4;
    const addrLines = doc.splitTextToSize(o.customerAddress || '-', contentW);
    doc.text(addrLines, margin, y);
    y += addrLines.length * 4 + 3;
    doc.line(margin, y, W - margin, y);
    y += 5;
    doc.setFont('helvetica', 'bold');
    doc.text('Product', margin, y); y += 4;
    doc.setFont('helvetica', 'normal');
    doc.text(o.productName || '-', margin, y); y += 4;
    doc.text('Code: ' + (o.productCode || '-'), margin, y); y += 4;
    doc.text('Color: ' + (o.colorName || '-'), margin, y); y += 4;
    doc.text('Size: ' + (o.size || '-'), margin, y); y += 4;
    doc.text('Qty: ' + (o.quantity || 1), margin, y); y += 4;
    doc.text('Price: ' + formatMoney(o.price), margin, y); y += 5;
    doc.line(margin, y, W - margin, y);
    y += 5;
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9);
    doc.text('TOTAL', margin, y);
    doc.text(formatMoney(o.total), W - margin, y, { align: 'right' });
    y += 6;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(6);
    doc.text('Date: ' + (o.date || '-') + ' ' + (o.time || ''), margin, y); y += 4;
    doc.text('Status: ' + (o.status || 'pending').toUpperCase(), margin, y); y += 8;
    doc.setDrawColor(212, 175, 55);
    doc.setLineWidth(1.2);
    doc.line(margin, y, W - margin, y);
    y += 6;
    doc.setFontSize(6);
    doc.setTextColor(120, 120, 120);
    doc.text('Thank you for shopping with us!', W / 2, y, { align: 'center' });
    y += 3;
    doc.text('nakowaabayas.com', W / 2, y, { align: 'center' });
    doc.save('receipt-' + o.orderId + '.pdf');
    showToast('Receipt downloaded', '🧾');
}

// ============================================================
// CUSTOMERS
// ============================================================
async function renderCustomers(myToken) {
    if (typeof myToken !== 'number') myToken = viewToken;
    $('pageTitle').textContent = 'Customers';
    currentSection = 'customers';
    if (cachedCustomers === null) cachedCustomers = [];
    drawCustomersSection();
    try {
        const customers = await apiGet('customers');
        if (!isViewCurrent(myToken)) return;
        cachedCustomers = customers || [];
        if (currentSection === 'customers') drawCustomersSection();
    } catch (e) { logOnce('customers-refresh-failed', '[Customers] refresh failed:', e); }
}

function drawCustomersSection() {
    const area = $('contentArea');
    if (cachedCustomers.length === 0) {
        area.innerHTML = '<div class="empty-state-admin"><i class="fas fa-users"></i><h4>No customers yet</h4></div>';
        return;
    }
    area.innerHTML =
        '<div class="admin-card">' +
            '<div class="card-title"><span><i class="fas fa-users"></i> All Customers (' + cachedCustomers.length + ')</span></div>' +
            '<div class="data-table-wrap"><table class="data-table">' +
                '<thead><tr><th>Phone</th><th>Name</th><th>Orders</th><th>Spent</th><th>Last Order</th></tr></thead>' +
                '<tbody>' +
                    cachedCustomers.map(function (c) {
                        return '<tr>' +
                            '<td><strong>' + escapeHtml(c.phone) + '</strong></td>' +
                            '<td>' + escapeHtml(c.name || '-') + '</td>' +
                            '<td>' + (c.totalOrders || 0) + '</td>' +
                            '<td style="color:var(--gold);font-weight:700;">' + formatMoney(c.totalSpent) + '</td>' +
                            '<td>' + escapeHtml(c.lastOrderDate || '-') + '</td>' +
                        '</tr>';
                    }).join('') +
                '</tbody>' +
            '</table></div>' +
        '</div>';
}

// ============================================================
// SETTINGS
// ============================================================
async function renderSettings(myToken) {
    if (typeof myToken !== 'number') myToken = viewToken;
    $('pageTitle').textContent = 'Settings';
    currentSection = 'settings';
    if (cachedSettings === null) cachedSettings = {};
    drawSettingsSection();
    try {
        const settings = await apiGet('settings');
        if (!isViewCurrent(myToken)) return;
        cachedSettings = settings || {};
        if (currentSection === 'settings') drawSettingsSection();
    } catch (e) { logOnce('settings-refresh-failed', '[Settings] refresh failed:', e); }
}

function drawSettingsSection() {
    const s = cachedSettings || {};
    $('contentArea').innerHTML =
        '<div class="admin-card">' +
            '<div class="card-title"><span><i class="fas fa-cog"></i> Website Settings</span></div>' +
            '<form class="admin-form" id="settingsForm">' +
                '<div class="form-group"><label>WhatsApp Number</label><input type="text" id="setWhatsapp" value="' + escapeHtml(s.whatsapp || '') + '" placeholder="+20 150 076 6295" /></div>' +
                '<div class="form-group"><label>Email</label><input type="email" id="setEmail" value="' + escapeHtml(s.email || '') + '" placeholder="info@nakowaabayas.com" /></div>' +
                '<div class="form-group"><label>Address</label><input type="text" id="setAddress" value="' + escapeHtml(s.address || '') + '" placeholder="Cairo, Egypt" /></div>' +
                '<div class="form-group"><label>Low Stock Threshold</label><input type="number" id="setThreshold" value="' + (s.lowStockThreshold || 3) + '" min="1" /></div>' +
                '<div class="form-group"><label>Hero Image URL</label><input type="text" id="setHero" value="' + escapeHtml(s.hero || '') + '" placeholder="https://..." /></div>' +
                '<div class="form-group"><label>Logo URL</label><input type="text" id="setLogo" value="' + escapeHtml(s.logo || '') + '" placeholder="https://..." /></div>' +
                '<div class="form-actions"><button type="submit" class="btn-gold"><i class="fas fa-save"></i> Save Settings</button></div>' +
            '</form>' +
        '</div>';

    $('settingsForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const newSettings = {
            whatsapp: $('setWhatsapp').value.trim(),
            email: $('setEmail').value.trim(),
            address: $('setAddress').value.trim(),
            lowStockThreshold: parseInt($('setThreshold').value, 10) || 3,
            hero: $('setHero').value.trim(),
            logo: $('setLogo').value.trim()
        };
        try {
            const res = await apiPost('updateSettings', { token: authToken, settings: newSettings });
            if (res && res.success) {
                cachedSettings = Object.assign({}, cachedSettings, newSettings);
                showToast('Settings saved!', '✅');
            } else showToast((res && res.message) || 'Failed', '❌');
        } catch (err) { showToast('Error: ' + err.message, '❌'); }
    });
}

// ============================================================
// USERS
// ============================================================
async function renderUsers(myToken) {
    if (typeof myToken !== 'number') myToken = viewToken;
    $('pageTitle').textContent = 'Users';
    currentSection = 'users';
    if (cachedUsers === null) cachedUsers = [];
    drawUsersSection();
    try {
        const users = await apiGet('users');
        if (!isViewCurrent(myToken)) return;
        cachedUsers = users || [];
        if (currentSection === 'users') drawUsersSection();
    } catch (e) { logOnce('users-refresh-failed', '[Users] refresh failed:', e); }
}

function drawUsersSection() {
    const users = cachedUsers || [];
    // Note: we no longer hard-code 'umar' on the client. The backend
    // decides which user is protected — the delete button is shown
    // for everyone, and the backend rejects a delete of the default
    // admin with a clear message.
    $('contentArea').innerHTML =
        '<div class="admin-card">' +
            '<div class="card-title"><span><i class="fas fa-user-shield"></i> Admin Users (' + users.length + ')</span></div>' +
            '<div class="data-table-wrap"><table class="data-table">' +
                '<thead><tr><th>Username</th><th>Role</th><th>Created</th><th>Last Login</th><th></th></tr></thead>' +
                '<tbody>' +
                    users.map(function (u) {
                        return '<tr>' +
                            '<td><strong>' + escapeHtml(u.username) + '</strong></td>' +
                            '<td>' + escapeHtml(u.role || '') + '</td>' +
                            '<td>' + (u.createdAt ? new Date(u.createdAt).toLocaleDateString() : '-') + '</td>' +
                            '<td>' + (u.lastLogin ? new Date(u.lastLogin).toLocaleString() : 'Never') + '</td>' +
                            '<td><button class="delete-btn" data-user="' + escapeHtml(u.username) + '" style="padding:5px 10px;border-radius:20px;background:#e74c3c;color:#fff;border:none;cursor:pointer;font-size:0.7rem;">Delete</button></td>' +
                        '</tr>';
                    }).join('') +
                '</tbody>' +
            '</table></div>' +
        '</div>' +
        '<div class="admin-card">' +
            '<div class="card-title"><span><i class="fas fa-plus"></i> Add New User</span></div>' +
            '<form class="admin-form" id="addUserForm">' +
                '<div class="form-row">' +
                    '<div class="form-group"><label>Username <span class="required">*</span></label><input type="text" id="newUsername" required /></div>' +
                    '<div class="form-group"><label>Password <span class="required">*</span></label><input type="password" id="newPassword" required /></div>' +
                '</div>' +
                '<div class="form-group"><label>Role</label><select id="newRole"><option value="admin">Admin</option><option value="staff">Staff</option></select></div>' +
                '<div class="form-actions"><button type="submit" class="btn-gold"><i class="fas fa-plus"></i> Add User</button></div>' +
            '</form>' +
        '</div>';

    document.querySelectorAll('[data-user]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const username = btn.dataset.user;
            showConfirm('Delete user?', 'Delete "' + username + '"?', async function () {
                try {
                    const res = await apiPost('deleteUser', { token: authToken, username: username });
                    if (res && res.success) {
                        cachedUsers = cachedUsers.filter(function (u) { return u.username !== username; });
                        showToast('User deleted', '🗑️');
                        if (currentSection === 'users') drawUsersSection();
                    } else showToast((res && res.message) || 'Failed', '❌');
                } catch (err) { showToast('Error: ' + err.message, '❌'); }
            });
        });
    });

    $('addUserForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const user = {
            username: $('newUsername').value.trim(),
            password: $('newPassword').value,
            role: $('newRole').value
        };
        if (!user.username || !user.password) return;
        try {
            const res = await apiPost('addUser', { token: authToken, user: user });
            if (res && res.success) {
                showToast('User added', '✅');
                const fresh = await apiGet('users');
                cachedUsers = fresh || cachedUsers;
                if (currentSection === 'users') drawUsersSection();
            } else showToast((res && res.message) || 'Failed', '❌');
        } catch (err) { showToast('Error: ' + err.message, '❌'); }
    });
}

// ============================================================
// CHANGE PASSWORD
// ============================================================
function renderChangePassword(myToken) {
    if (!isAdminAuthenticated()) {
        showToast('Please log in first.', '🔒');
        $('dashboard').style.display = 'none';
        $('loginScreen').style.display = 'flex';
        return;
    }
    $('pageTitle').textContent = 'Change Password';
    currentSection = 'changepassword';
    $('contentArea').innerHTML =
        '<div class="admin-card">' +
            '<div class="card-title"><span><i class="fas fa-key"></i> Change Admin Password</span></div>' +
            '<form class="admin-form" id="changePasswordForm">' +
                '<div class="form-group"><label>Current Password <span class="required">*</span></label><input type="password" id="cpOld" required /></div>' +
                '<div class="form-group"><label>New Password <span class="required">*</span></label><input type="password" id="cpNew" required minlength="4" /></div>' +
                '<div class="form-group"><label>Confirm New Password <span class="required">*</span></label><input type="password" id="cpConfirm" required minlength="4" /></div>' +
                '<div class="form-actions"><button type="submit" class="btn-gold"><i class="fas fa-key"></i> Change Password</button></div>' +
            '</form>' +
        '</div>';

    $('changePasswordForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        if (!isAdminAuthenticated()) { showToast('Not authenticated.', '🔒'); return; }
        const oldPassword = $('cpOld').value;
        const newPassword = $('cpNew').value;
        const confirm = $('cpConfirm').value;
        if (!oldPassword || !newPassword) { showToast('Please fill in all fields', '⚠️'); return; }
        if (newPassword !== confirm) { showToast('Passwords do not match', '⚠️'); return; }
        if (newPassword.length < 4) { showToast('Password must be at least 4 characters', '⚠️'); return; }
        try {
        const currentUser = (function () { try { return sessionStorage.getItem(USER_KEY) || 'umar'; } catch (e) { return 'umar'; } })();
        const okOld = await verifyLocalCredentials(currentUser, oldPassword);
        if (!okOld) { showToast('Current password is incorrect.', '❌'); return; }
        await setLocalCredentials(currentUser, newPassword);
            if (res && res.success) {
                showToast('Password changed! Please log in with the new password.', '✅');
                setTimeout(function () { doLogout(true); }, 1500);
            } else showToast((res && res.message) || 'Failed', '❌');
        } catch (err) { showToast('Error: ' + err.message, '❌'); }
    });
}

// ============================================================
// INIT
// ============================================================
document.addEventListener('DOMContentLoaded', function () {
    // Clear the legacy localStorage key (spec).
    try { NakowaQueue.removeLegacyLocalStorageKey(); } catch (e) {}

    const token = checkAuth();
    if (token) {
        authToken = token;
        try { currentAdmin = sessionStorage.getItem(USER_KEY) || ''; } catch (e) {}
        $('loginScreen').style.display = 'none';
        $('dashboard').style.display = 'flex';
        startIdleTimer();
        warmCache().then(function () {
            initQueueAfterLogin();
            loadSection('dashboard');
        });
    } else {
        // Show the login screen even if it was hidden by a previous session.
        $('loginScreen').style.display = 'flex';
        $('dashboard').style.display = 'none';
    }

    $('loginBtn').addEventListener('click', doLogin);
    $('loginPassword').addEventListener('keypress', function (e) { if (e.key === 'Enter') doLogin(); });
    $('loginUsername').addEventListener('keypress', function (e) { if (e.key === 'Enter') $('loginPassword').focus(); });

    document.querySelectorAll('.sidebar li[data-section]').forEach(function (li) {
        li.addEventListener('click', function () { loadSection(li.dataset.section); });
    });

    $('logoutBtn').addEventListener('click', function () {
        showConfirm('Logout?', 'Are you sure you want to logout?', function () { doLogout(); });
    });

    $('hamburgerAdmin').addEventListener('click', function () { $('sidebar').classList.add('open'); });
    $('sidebarClose').addEventListener('click', function () { $('sidebar').classList.remove('open'); });
    $('closeImageViewer').addEventListener('click', function () { $('imageViewer').classList.remove('open'); });
    $('imageViewer').addEventListener('click', function (e) {
        if (e.target === $('imageViewer')) $('imageViewer').classList.remove('open');
    });
    $('confirmModal').addEventListener('click', function (e) {
        if (e.target === $('confirmModal')) $('confirmModal').classList.remove('open');
    });
});
